# ==============================================================================
# PitchTrade Environment Variables (.env.local)
# Copy this file to `.env.local` and fill in the required secrets.
# Never commit `.env.local` or hardcode credentials in source files.
# ==============================================================================

# 1. API-Football v3 (https://www.api-football.com/)
# Primary real-data provider for fixtures, lineups, events, and player stats.
API_FOOTBALL_KEY=

# 2. Football-Data.org v4 (optional secondary fallback)
FOOTBALL_DATA_API_KEY=

# 3. Supabase PostgreSQL + Drizzle ORM
# - DATABASE_URL: Supabase Transaction Pooler URI (port 6543, pgbouncer/transaction mode).
#   Used by Next.js runtime with `prepare: false`.
#   When unset in local/test environments, PitchTrade safely falls back to in-memory cache.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# - DIRECT_URL: Supabase Session/Direct URI (port 5432).
#   Used by `drizzle-kit` (`npm run db:generate` / `npm run db:push`) for schema migrations.
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres"

# 4. Supabase Auth (Browser & Server SSR Cookie Session)
# - Copy Project URL and Publishable/Anon Key from Supabase Dashboard -> Project Settings -> API.
# - Either NEXT_PUBLIC_SUPABASE_ANON_KEY or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is supported.
# - When unset in local/test environments, PitchTrade safely falls back to local demo auth.
NEXT_PUBLIC_SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<SUPABASE_ANON_OR_PUBLISHABLE_KEY>"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<SUPABASE_PUBLISHABLE_KEY>"
